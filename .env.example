# Copia este archivo a .env y ajusta los valores reales antes de correr el backend.
# SQLite: la base de datos es un único archivo. En desarrollo vive junto al proyecto;
# en el PC de Billar (producción) conviene apuntarlo a una ruta fija fuera del código,
# por ejemplo "file:C:/laspalmas/data/las_palmas.db", para que sobreviva a actualizaciones
# del backend y sea fácil de respaldar.
DATABASE_URL="file:./dev.db"
JWT_SECRET="cambia-este-valor-por-uno-largo-y-aleatorio"
JWT_EXPIRES_IN="12h"
PORT=4000
