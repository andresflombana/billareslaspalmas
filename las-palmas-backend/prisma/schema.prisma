// ============================================================
// LAS PALMAS — Modelo de datos (Sprint 0: "modelo ER congelado")
//
// Regla arquitectónica principal (no negociable en ningún sprint):
// un único sistema, una única API, una única base de datos.
// Billar, Venta Directa y Licorera son CONTEXTOS OPERATIVOS que
// comparten productos, inventario, ventas, caja, usuarios e
// historial (RN-05). No se modelan como sistemas independientes.
//
// Motor: SQLite (ver ESTADO_PROYECTO.md para el porqué del cambio
// frente a MySQL). El conector de SQLite en Prisma NO soporta los
// tipos `enum` ni `Json` nativos, así que los campos que en un motor
// como MySQL/PostgreSQL serían enum aquí son `String`, con el
// conjunto de valores válidos documentado junto al campo y con una
// única fuente de verdad en código: src/constants/enums.ts. La
// validación de esos valores se hace en la capa de aplicación
// (Sprint 1 en adelante), no en la base de datos.
//
// Cada modelo referencia entre paréntesis la(s) historia(s) de
// usuario del Product Backlog que lo originan, para trazabilidad.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------- Épica 1 — Autenticación y usuarios (HU-01, HU-02, HU-03) ----------------

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String   @unique
  passwordHash String
  rol          String // 'ADMINISTRADOR' | 'OPERADOR' — ver src/constants/enums.ts (ROLES)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ventasAtendidas       Venta[]                @relation("VentaUsuario")
  movimientosInventario MovimientoInventario[]
  obsequios             Obsequio[]
  gastos                Gasto[]
  auditorias            AuditLog[]
  cajasAbiertas         CajaPuntoVenta[]       @relation("CajaAperturaUsuario")
  cajasCerradas         CajaPuntoVenta[]       @relation("CajaCierreUsuario")

  @@map("usuarios")
}

// ---------------- Módulo Billar — Mesas (HU-06 a HU-11, HU-24) ----------------

model Mesa {
  id              Int       @id @default(autoincrement())
  nombre          String    @unique
  zona            String
  estado          String    @default("LIBRE") // ESTADOS_MESA: LIBRE | OCUPADA | FUERA_SERVICIO | RESERVADA
  tarifaPorMinuto Int
  startedAt       DateTime?
  observaciones   String?
  // Baja lógica (RN-15, HU-43). Agregado en Sprint 1 como única excepción al
  // "modelo ER congelado": false = mesa dada de baja → no aparece en /billar
  // ni se puede abrir, pero conserva su historial de ventas y auditoría.
  // Distinto de estado = FUERA_SERVICIO, que es temporal y sí se ve en /billar.
  activa          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ventas Venta[]

  @@map("mesas")
}

// ---------------- Módulo Billar — Barra (HU-16, HU-17) ----------------

model Barra {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique // "Barra 1", "Barra 2"
  estado    String   @default("CERRADA") // ESTADOS_BARRA: ABIERTA | CERRADA
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cuentas CuentaBarra[]

  @@map("barras")
}

model CuentaBarra {
  id            Int       @id @default(autoincrement())
  barraId       Int
  barra         Barra     @relation(fields: [barraId], references: [id])
  etiqueta      String? // identificador libre que usa el operador (ej. "Mesa alta 2")
  estado        String    @default("ABIERTA") // ESTADOS_CUENTA_BARRA: ABIERTA | CERRADA
  abiertaEn     DateTime  @default(now())
  cerradaEn     DateTime?
  observaciones String?

  ventas Venta[]

  @@map("cuentas_barra")
}

// ---------------- Épicas 7/8/9 — Catálogo, inventario y precios (HU-18 a HU-25) ----------------

model Producto {
  id            Int      @id @default(autoincrement())
  nombre        String
  sku           String   @unique
  categoria     String
  precioInterno Int // aplica en Billar (mesas y barra)
  precioExterno Int // aplica en Venta Directa y Licorera
  costo         Int?
  stock         Int      @default(0) // inventario ÚNICO (HU-21): un solo stock para los 3 módulos
  stockMinimo   Int      @default(0)
  codigoBarras  String?  @unique
  imagenUrl     String?
  colorToken    String? // fallback visual derivado del SKU (HU-19)
  activo        Boolean  @default(true) // baja lógica, nunca se borra (HU-20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  itemsVenta  ItemVenta[]
  movimientos MovimientoInventario[]
  obsequios   Obsequio[]

  @@map("productos")
}

model MovimientoInventario {
  id         Int       @id @default(autoincrement())
  productoId Int
  producto   Producto  @relation(fields: [productoId], references: [id])
  tipo       String // TIPOS_MOVIMIENTO_INVENTARIO: VENTA | OBSEQUIO | ENTRADA | AJUSTE
  cantidad   Int // negativo = salida, positivo = entrada
  ventaId    Int?
  venta      Venta?    @relation(fields: [ventaId], references: [id])
  obsequioId Int?
  obsequio   Obsequio? @relation(fields: [obsequioId], references: [id])
  usuarioId  Int?
  usuario    Usuario?  @relation(fields: [usuarioId], references: [id])
  fecha      DateTime  @default(now())

  @@map("movimientos_inventario")
}

// ---------------- Épicas 10/11/12/13 — Ventas y facturación (HU-26 a HU-31) ----------------

model Venta {
  id                      Int          @id @default(autoincrement())
  origen                  String // ORIGENES_VENTA: MESA | BARRA | VENTA_DIRECTA | LICORERA
  puntoVenta              String // PUNTOS_VENTA: BILLAR | VENTA_DIRECTA | LICORERA
  mesaId                  Int?
  mesa                    Mesa?        @relation(fields: [mesaId], references: [id])
  cuentaBarraId           Int?
  cuentaBarra             CuentaBarra? @relation(fields: [cuentaBarraId], references: [id])
  usuarioId               Int
  usuario                 Usuario      @relation("VentaUsuario", fields: [usuarioId], references: [id])
  estado                  String       @default("ABIERTA") // ESTADOS_VENTA: ABIERTA | CERRADA | ANULADA
  tarifaPorMinutoAplicada Int? // congelada al abrir la mesa, no la tarifa vigente al cerrar
  subtotalProductos       Int          @default(0)
  subtotalTiempo          Int          @default(0)
  total                   Int          @default(0)
  formaPago               String? // FORMAS_PAGO: EFECTIVO | TRANSFERENCIA | FIADO
  fechaApertura           DateTime     @default(now())
  fechaCierre             DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  items                 ItemVenta[]
  movimientosInventario MovimientoInventario[]
  movimientosCaja       MovimientoCaja[]

  @@map("ventas")
}

model ItemVenta {
  id             Int      @id @default(autoincrement())
  ventaId        Int
  venta          Venta    @relation(fields: [ventaId], references: [id])
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id])
  cantidad       Int
  precioUnitario Int // congelado al agregar (HU-25): cambios futuros del catálogo no lo alteran
  precioEditado  Boolean  @default(false) // true si el operador aplicó un descuento puntual (HU-15)
  observaciones  String?
  createdAt      DateTime @default(now())

  @@map("items_venta")
}

// ---------------- Épica 14 — Obsequios para clientes (HU-32 a HU-35) ----------------

model Obsequio {
  id          Int      @id @default(autoincrement())
  productoId  Int
  producto    Producto @relation(fields: [productoId], references: [id])
  cantidad    Int
  motivo      String
  observacion String?
  origen      String // ORIGENES_VENTA: MESA | BARRA | VENTA_DIRECTA | LICORERA
  usuarioId   Int
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
  fecha       DateTime @default(now())

  movimientosInventario MovimientoInventario[]

  @@map("obsequios")
}

// ---------------- Épica 15 — Caja (HU-36 a HU-38) ----------------

model CajaPuntoVenta {
  id                Int       @id @default(autoincrement())
  puntoVenta        String // PUNTOS_VENTA: BILLAR | VENTA_DIRECTA | LICORERA
  estado            String    @default("CERRADA") // ESTADOS_CAJA: ABIERTA | CERRADA
  baseApertura      Int       @default(0)
  fechaApertura     DateTime?
  fechaCierre       DateTime?
  totalContado      Int?
  diferencia        Int? // contado - esperado; 0 = cuadra, !=0 = faltante o sobrante
  usuarioAperturaId Int?
  usuarioApertura   Usuario?  @relation("CajaAperturaUsuario", fields: [usuarioAperturaId], references: [id])
  usuarioCierreId   Int?
  usuarioCierre     Usuario?  @relation("CajaCierreUsuario", fields: [usuarioCierreId], references: [id])

  movimientos MovimientoCaja[]

  @@map("cajas_punto_venta")
}

model MovimientoCaja {
  id          Int            @id @default(autoincrement())
  cajaId      Int
  caja        CajaPuntoVenta @relation(fields: [cajaId], references: [id])
  tipo        String // TIPOS_MOVIMIENTO_CAJA: INGRESO | EGRESO
  descripcion String
  monto       Int
  ventaId     Int?
  venta       Venta?         @relation(fields: [ventaId], references: [id])
  gastoId     Int?
  gasto       Gasto?         @relation(fields: [gastoId], references: [id])
  hora        DateTime       @default(now())

  @@map("movimientos_caja")
}

// ---------------- Módulo Gastos ----------------

model Gasto {
  id            Int      @id @default(autoincrement())
  fecha         DateTime @default(now())
  categoria     String
  descripcion   String
  monto         Int
  usuarioId     Int
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
  observaciones String?

  movimientosCaja MovimientoCaja[]

  @@map("gastos")
}

// ---------------- Auditoría (HU-15, HU-42) ----------------

model AuditLog {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  entidad   String // ej. "ItemVenta", "Producto"
  entidadId Int
  accion    String // ej. "PRECIO_EDITADO", "PRODUCTO_DESACTIVADO"
  detalle   String? // JSON serializado a mano (String.stringify) — SQLite no soporta el tipo Json de Prisma
  fecha     DateTime @default(now())

  @@map("audit_log")
}

// ---------------- Configuración general del negocio ----------------

model ConfiguracionNegocio {
  id                     Int      @id @default(1)
  nombreNegocio          String
  tarifaPorMinutoDefault Int
  direccion              String?
  telefono               String?
  updatedAt              DateTime @updatedAt

  @@map("configuracion_negocio")
}
