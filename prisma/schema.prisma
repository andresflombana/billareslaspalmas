// ============================================================
// LAS PALMAS — Modelo de datos (Sprint 0: "modelo ER congelado")
//
// Regla arquitectónica principal (no negociable en ningún sprint):
// un único sistema, una única API, una única base de datos MySQL.
// Billar, Venta Directa y Licorera son CONTEXTOS OPERATIVOS que
// comparten productos, inventario, ventas, caja, usuarios e
// historial (RN-05). No se modelan como sistemas independientes.
//
// Cada modelo referencia entre paréntesis la(s) historia(s) de
// usuario del Product Backlog que lo originan, para trazabilidad.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------- ENUMS ----------------

enum Rol {
  ADMINISTRADOR
  OPERADOR
}

enum EstadoMesa {
  LIBRE
  OCUPADA
  FUERA_SERVICIO
  RESERVADA
}

enum EstadoBarra {
  ABIERTA
  CERRADA
}

enum EstadoCuentaBarra {
  ABIERTA
  CERRADA
}

// Los tres puntos de caja reales del negocio (HU-36, HU-37).
// Barra liquida dentro de BILLAR: no es un cuarto punto de venta.
enum PuntoVenta {
  BILLAR
  VENTA_DIRECTA
  LICORERA
}

// Dónde se originó la venta, más específico que PuntoVenta.
enum OrigenVenta {
  MESA
  BARRA
  VENTA_DIRECTA
  LICORERA
}

enum EstadoVenta {
  ABIERTA
  CERRADA
  ANULADA
}

enum FormaPago {
  EFECTIVO
  TRANSFERENCIA
  FIADO
}

enum TipoMovimientoInventario {
  VENTA
  OBSEQUIO
  ENTRADA
  AJUSTE
}

enum EstadoCaja {
  ABIERTA
  CERRADA
}

enum TipoMovimientoCaja {
  INGRESO
  EGRESO
}

// ---------------- Épica 1 — Autenticación y usuarios (HU-01, HU-02, HU-03) ----------------

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String   @unique
  passwordHash String
  rol          Rol
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ventasAtendidas       Venta[]                @relation("VentaUsuario")
  movimientosInventario MovimientoInventario[]
  obsequios             Obsequio[]
  gastos                Gasto[]
  auditorias            AuditLog[]
  cajasAbiertas         CajaPuntoVenta[]       @relation("CajaAperturaUsuario")
  cajasCerradas         CajaPuntoVenta[]       @relation("CajaCierreUsuario")

  @@map("usuarios")
}

// ---------------- Módulo Billar — Mesas (HU-06 a HU-11, HU-24) ----------------

model Mesa {
  id              Int        @id @default(autoincrement())
  nombre          String     @unique
  zona            String
  estado          EstadoMesa @default(LIBRE)
  tarifaPorMinuto Int
  startedAt       DateTime?
  observaciones   String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  ventas          Venta[]

  @@map("mesas")
}

// ---------------- Módulo Billar — Barra (HU-16, HU-17) ----------------

model Barra {
  id        Int         @id @default(autoincrement())
  nombre    String      @unique // "Barra 1", "Barra 2"
  estado    EstadoBarra @default(CERRADA)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  cuentas   CuentaBarra[]

  @@map("barras")
}

model CuentaBarra {
  id            Int               @id @default(autoincrement())
  barraId       Int
  barra         Barra             @relation(fields: [barraId], references: [id])
  etiqueta      String? // identificador libre que usa el operador (ej. "Mesa alta 2")
  estado        EstadoCuentaBarra @default(ABIERTA)
  abiertaEn     DateTime          @default(now())
  cerradaEn     DateTime?
  observaciones String?

  ventas        Venta[]

  @@map("cuentas_barra")
}

// ---------------- Épicas 7/8/9 — Catálogo, inventario y precios (HU-18 a HU-25) ----------------

model Producto {
  id            Int      @id @default(autoincrement())
  nombre        String
  sku           String   @unique
  categoria     String
  precioInterno Int // aplica en Billar (mesas y barra)
  precioExterno Int // aplica en Venta Directa y Licorera
  costo         Int?
  stock         Int      @default(0) // inventario ÚNICO (HU-21): un solo stock para los 3 módulos
  stockMinimo   Int      @default(0)
  codigoBarras  String?  @unique
  imagenUrl     String?
  colorToken    String? // fallback visual derivado del SKU (HU-19)
  activo        Boolean  @default(true) // baja lógica, nunca se borra (HU-20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  itemsVenta  ItemVenta[]
  movimientos MovimientoInventario[]
  obsequios   Obsequio[]

  @@map("productos")
}

model MovimientoInventario {
  id         Int                      @id @default(autoincrement())
  productoId Int
  producto   Producto                 @relation(fields: [productoId], references: [id])
  tipo       TipoMovimientoInventario
  cantidad   Int // negativo = salida, positivo = entrada
  ventaId    Int?
  venta      Venta?                   @relation(fields: [ventaId], references: [id])
  obsequioId Int?
  obsequio   Obsequio?                @relation(fields: [obsequioId], references: [id])
  usuarioId  Int?
  usuario    Usuario?                 @relation(fields: [usuarioId], references: [id])
  fecha      DateTime                 @default(now())

  @@map("movimientos_inventario")
}

// ---------------- Épicas 10/11/12/13 — Ventas y facturación (HU-26 a HU-31) ----------------

model Venta {
  id                      Int         @id @default(autoincrement())
  origen                  OrigenVenta
  puntoVenta              PuntoVenta
  mesaId                  Int?
  mesa                    Mesa?       @relation(fields: [mesaId], references: [id])
  cuentaBarraId           Int?
  cuentaBarra             CuentaBarra? @relation(fields: [cuentaBarraId], references: [id])
  usuarioId               Int
  usuario                 Usuario     @relation("VentaUsuario", fields: [usuarioId], references: [id])
  estado                  EstadoVenta @default(ABIERTA)
  tarifaPorMinutoAplicada Int? // congelada al abrir la mesa, no la tarifa vigente al cerrar
  subtotalProductos       Int         @default(0)
  subtotalTiempo          Int         @default(0)
  total                   Int         @default(0)
  formaPago               FormaPago?
  fechaApertura           DateTime    @default(now())
  fechaCierre             DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  items                 ItemVenta[]
  movimientosInventario MovimientoInventario[]
  movimientosCaja       MovimientoCaja[]

  @@map("ventas")
}

model ItemVenta {
  id             Int      @id @default(autoincrement())
  ventaId        Int
  venta          Venta    @relation(fields: [ventaId], references: [id])
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id])
  cantidad       Int
  precioUnitario Int // congelado al agregar (HU-25): cambios futuros del catálogo no lo alteran
  precioEditado  Boolean  @default(false) // true si el operador aplicó un descuento puntual (HU-15)
  observaciones  String?
  createdAt      DateTime @default(now())

  @@map("items_venta")
}

// ---------------- Épica 14 — Obsequios para clientes (HU-32 a HU-35) ----------------

model Obsequio {
  id          Int         @id @default(autoincrement())
  productoId  Int
  producto    Producto    @relation(fields: [productoId], references: [id])
  cantidad    Int
  motivo      String
  observacion String?
  origen      OrigenVenta
  usuarioId   Int
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])
  fecha       DateTime    @default(now())

  movimientosInventario MovimientoInventario[]

  @@map("obsequios")
}

// ---------------- Épica 15 — Caja (HU-36 a HU-38) ----------------

model CajaPuntoVenta {
  id                Int        @id @default(autoincrement())
  puntoVenta        PuntoVenta
  estado            EstadoCaja @default(CERRADA)
  baseApertura      Int        @default(0)
  fechaApertura     DateTime?
  fechaCierre       DateTime?
  totalContado      Int?
  diferencia        Int? // contado - esperado; 0 = cuadra, !=0 = faltante o sobrante
  usuarioAperturaId Int?
  usuarioApertura   Usuario?   @relation("CajaAperturaUsuario", fields: [usuarioAperturaId], references: [id])
  usuarioCierreId   Int?
  usuarioCierre     Usuario?   @relation("CajaCierreUsuario", fields: [usuarioCierreId], references: [id])

  movimientos MovimientoCaja[]

  @@map("cajas_punto_venta")
}

model MovimientoCaja {
  id          Int                @id @default(autoincrement())
  cajaId      Int
  caja        CajaPuntoVenta     @relation(fields: [cajaId], references: [id])
  tipo        TipoMovimientoCaja
  descripcion String
  monto       Int
  ventaId     Int?
  venta       Venta?             @relation(fields: [ventaId], references: [id])
  gastoId     Int?
  gasto       Gasto?             @relation(fields: [gastoId], references: [id])
  hora        DateTime           @default(now())

  @@map("movimientos_caja")
}

// ---------------- Módulo Gastos ----------------

model Gasto {
  id            Int      @id @default(autoincrement())
  fecha         DateTime @default(now())
  categoria     String
  descripcion   String
  monto         Int
  usuarioId     Int
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
  observaciones String?

  movimientosCaja MovimientoCaja[]

  @@map("gastos")
}

// ---------------- Auditoría (HU-15, HU-42) ----------------

model AuditLog {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  entidad   String // ej. "ItemVenta", "Producto"
  entidadId Int
  accion    String // ej. "PRECIO_EDITADO", "PRODUCTO_DESACTIVADO"
  detalle   Json?
  fecha     DateTime @default(now())

  @@map("audit_log")
}

// ---------------- Configuración general del negocio ----------------

model ConfiguracionNegocio {
  id                     Int      @id @default(1)
  nombreNegocio          String
  tarifaPorMinutoDefault Int
  direccion              String?
  telefono               String?
  updatedAt              DateTime @updatedAt

  @@map("configuracion_negocio")
}
